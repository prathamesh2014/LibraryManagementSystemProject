@model List<Domain.Entities.IssueBook>
@{
    ViewData["Title"] = "Issued Books";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Issued Books</h3>
    <a asp-action="Create" class="btn btn-primary">+ Issue Book</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<table class="table table-bordered table-hover">
    <thead class="table-light">
        <tr>
            <th>Book</th>
            <th>Member</th>
            <th>Issue Date</th>
            <th>Due Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var issue in Model)
        {
            <tr>
                <td>@issue.Book.Title</td>
                <td>@issue.Member.FullName</td>
                <td>@issue.IssueDate.ToString("dd-MMM-yyyy")</td>
                <td>@issue.DueDate.ToString("dd-MMM-yyyy")</td>
                <td>
                    @if (issue.Status == "Issued")
                    {
                        @if (issue.DueDate < DateTime.Now)
                        {
                            <span class="badge bg-danger">Overdue</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Issued</span>
                        }
                    }
                    else
                    {
                        <span class="badge bg-success">Returned</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@issue.IssueId" class="btn btn-sm btn-info">Details</a>
                    @if (issue.Status == "Issued")
                    {
                        <a asp-controller="ReturnBook" asp-action="Return" asp-route-id="@issue.IssueId" class="btn btn-sm btn-success">Return</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No books issued yet.</p>
}