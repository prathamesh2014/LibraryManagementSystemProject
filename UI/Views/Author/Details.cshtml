@model Domain.Entities.Author
@{
    ViewData["Title"] = "Author Details";
    Layout = "_Layout";
}

<h3>Author Details</h3>

<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Author Name</dt>
            <dd class="col-sm-8">@Model.AuthorName</dd>

            <dt class="col-sm-4">Biography</dt>
            <dd class="col-sm-8">@Model.Biography</dd>
        </dl>
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary mt-3">Back to List</a>