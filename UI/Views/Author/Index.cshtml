@model List<Domain.Entities.Author>
@{
    ViewData["Title"] = "Authors";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Authors</h3>
    <a asp-action="Create" class="btn btn-primary">+ Add Author</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-bordered table-hover">
    <thead class="table-light">
        <tr>
            <th>Author Name</th>
            <th>Biography</th>
            <th style="width: 220px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var author in Model)
        {
            <tr>
                <td>@author.AuthorName</td>
                <td>@(author.Biography != null && author.Biography.Length > 60 ? author.Biography.Substring(0, 60) + "..." : author.Biography)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@author.AuthorId" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@author.AuthorId" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@author.AuthorId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No authors found. Click "Add Author" to create one.</p>
}