@model Domain.Entities.IssueBook
@{
    ViewData["Title"] = "Return Confirmation";
    Layout = "_Layout";
}

<h3 class="text-success">Book Returned Successfully</h3>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-4">Book</dt>
            <dd class="col-sm-8">@Model.Book.Title</dd>

            <dt class="col-sm-4">Member</dt>
            <dd class="col-sm-8">@Model.Member.FullName</dd>

            <dt class="col-sm-4">Return Date</dt>
            <dd class="col-sm-8">@Model.ReturnDate?.ToString("dd-MMM-yyyy")</dd>

            <dt class="col-sm-4">Fine Amount</dt>
            <dd class="col-sm-8">
                @if (Model.FineAmount > 0)
                {
                    <span class="badge bg-danger">₹@Model.FineAmount</span>
                }
                else
                {
                    <span class="badge bg-success">No Fine</span>
                }
            </dd>
        </dl>
    </div>
</div>

<a asp-controller="IssueBook" asp-action="Index" class="btn btn-primary mt-3">Back to Issued Books</a>