@model List<Domain.Entities.Book>
@{
    ViewData["Title"] = "Books";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3>Books</h3>
    <div>
        <a asp-action="Deleted" class="btn btn-outline-secondary">View Deleted</a>
        <a asp-action="Create" class="btn btn-primary">+ Add Book</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-4">
        <input type="text" name="searchTitle" value="@ViewBag.SearchTitle" class="form-control" placeholder="Search by title..." />
    </div>
    <div class="col-md-3">
        <select name="categoryId" class="form-select">
            <option value="">-- All Categories --</option>
            @foreach (var category in (List<Domain.Entities.Category>)ViewBag.Categories)
            {
                <option value="@category.CategoryId" selected="@(ViewBag.SelectedCategoryId == category.CategoryId)">
                    @category.CategoryName
                </option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select name="authorId" class="form-select">
            ...
        </select>
    </div>
    <div class="col-md-1">
        <button type="submit" class="btn btn-outline-primary w-100">Search</button>
    </div>
    <div class="col-md-1">
        <a asp-action="Index" class="btn btn-outline-secondary w-100">Clear</a>
    </div>
</form>

<table class="table table-bordered table-hover">
    <thead class="table-light">
        <tr>
            <th>Cover</th>
            <th>Title</th>
            <th>Author</th>
            <th>Category</th>
            <th>Available / Total</th>
            <th style="width: 220px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var book in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(book.ImagePath))
                    {
                        <img src="@book.ImagePath" style="width: 50px; height: 70px; object-fit: cover;" />
                    }
                    else
                    {
                        <span class="text-muted">No Image</span>
                    }
                </td>
                <td>@book.Title</td>
                <td>@book.Author.AuthorName</td>
                <td>@book.Category.CategoryName</td>
                <td>
                    <span class="badge @(book.AvailableCopies > 0 ? "bg-success" : "bg-danger")">
                        @book.AvailableCopies / @book.TotalCopies
                    </span>
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@book.BookId" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Edit" asp-route-id="@book.BookId" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@book.BookId" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    @if (!string.IsNullOrEmpty((string)ViewBag.SearchTitle) || ViewBag.SelectedCategoryId != null || ViewBag.SelectedAuthorId != null)
    {
        <p class="text-muted">No books match your search. Try different filters.</p>
    }
    else
    {
        <p class="text-muted">No books found. Click "Add Book" to create one.</p>
    }
}