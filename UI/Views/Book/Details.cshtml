@model Domain.Entities.Book
@{
    ViewData["Title"] = "Book Details";
    Layout = "_Layout";
}

<h3>Book Details</h3>

<div class="card" style="max-width: 600px;">
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <img src="@Model.ImagePath" style="width: 120px; margin-bottom: 15px;" />
        }
        <dl class="row">
            <dt class="col-sm-4">Title</dt>
            <dd class="col-sm-8">@Model.Title</dd>

            <dt class="col-sm-4">ISBN</dt>
            <dd class="col-sm-8">@Model.ISBN</dd>

            <dt class="col-sm-4">Publisher</dt>
            <dd class="col-sm-8">@Model.Publisher</dd>

            <dt class="col-sm-4">Publish Year</dt>
            <dd class="col-sm-8">@Model.PublishYear</dd>

            <dt class="col-sm-4">Category</dt>
            <dd class="col-sm-8">@Model.Category.CategoryName</dd>

            <dt class="col-sm-4">Author</dt>
            <dd class="col-sm-8">@Model.Author.AuthorName</dd>

            <dt class="col-sm-4">Copies</dt>
            <dd class="col-sm-8">@Model.AvailableCopies available out of @Model.TotalCopies</dd>
        </dl>
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary mt-3">Back to List</a>