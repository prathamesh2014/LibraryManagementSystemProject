@model Domain.Entities.Book
@{
    ViewData["Title"] = "Delete Book";
    Layout = "_Layout";
}

<h3>Delete Book</h3>

<p>Are you sure you want to delete this book?</p>

<div class="row">
    <div class="col-md-6">
        <dl class="row">
            <dt class="col-sm-4">Title</dt>
            <dd class="col-sm-8">@Model.Title</dd>

            <dt class="col-sm-4">ISBN</dt>
            <dd class="col-sm-8">@Model.ISBN</dd>

            <dt class="col-sm-4">Publisher</dt>
            <dd class="col-sm-8">@Model.Publisher</dd>

            <dt class="col-sm-4">Publish Year</dt>
            <dd class="col-sm-8">@Model.PublishYear</dd>

            <dt class="col-sm-4">Total Copies</dt>
            <dd class="col-sm-8">@Model.TotalCopies</dd>
        </dl>

        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <img src="@Model.ImagePath" style="width: 100px;" />
        }
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="BookId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>